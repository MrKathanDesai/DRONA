    "models": "Saved CNN checkpoint and Random Forest reconstructed with the original fixed training configuration; neither model is trained on noisy test clips",
    "thresholds": "Fixed validation-selected thresholds from clean training runs; no threshold tuning on test/noisy conditions",
    "noise": {
      "types": [
        "white",
        "pink"
      ],
      "snr_db": [
        20,
        10,
        5,
        0
      ],
      "seed_policy": "Deterministic SHA-256 seed per filename, noise type, and SNR",
      "silence_count": 129,
      "silence_policy": "Zero-energy clips use the median RMS of non-silent training drone clips as the noise reference; these are noise-only conditions and do not have a physically defined SNR.",
      "warning": "White and pink noise are controlled synthetic conditions, not recordings of real speech, traffic, wind, or music."
    },
    "rf_model_reconstruction": {
      "n_estimators": 300,
      "class_weight": "balanced_subsample",
      "random_state": 42,
      "validation_threshold_matches_saved_report": true
    },
    "clean_score_reproduction": {
      "random_forest_f1_matches_saved_report": true,
      "cnn_f1_matches_saved_report": true
    },
    "features": "Random Forest receives the complete original-duration waveform, matching baseline preprocessing. CNN receives its centered one-second window, zero-padded if short, matching CNN preprocessing."
  },
